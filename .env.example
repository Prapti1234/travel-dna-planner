# Copy this file to ".env" (same folder) and fill in your values. Never commit .env.

# --- Required -----------------------------------------------------------
# Groq LLM - https://console.groq.com/keys
GROQ_API_KEY=
# Optional: any Groq chat model that supports JSON mode
GROQ_MODEL=openai/gpt-oss-120b

# --- Data sources (app still runs without them, and says what's missing) ---
# Tavily web search (remote MCP server) - https://app.tavily.com
TAVILY_API_KEY=
# OpenWeatherMap (our own MCP server) - https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=
# AviationStack (open-source aviationstack-mcp server, started with uvx) - https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=
# free  = 100 requests/month, live status of a flight number only
# basic = paid plan, future flight schedules for your travel dates
AVIATIONSTACK_PLAN=free

# --- Memory (PostgreSQL) -----------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# If it can't connect, the app uses temporary memory and shows a warning.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/travel_assistant

# --- Optional tuning ----------------------------------------------------
BUDGET_CONTINGENCY=0.10
MCP_TIMEOUT_SECONDS=60
# Override how the AviationStack MCP server is launched (default: uvx --python 3.13 aviationstack-mcp==1.8.1)
# AVIATIONSTACK_MCP_COMMAND=uvx
# AVIATIONSTACK_MCP_ARGS=--python 3.13 aviationstack-mcp==1.8.1
